# GEMINI_API_KEY: Required for Gemini AI Care Assistant API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EMAIL_PROVIDER: Optional provider selector: auto | resend | sendgrid | webhook (defaults to auto).
# When no provider credentials are set, CareCircle runs in clearly labelled Simulated Notification Mode.
EMAIL_PROVIDER="auto"

# EMAIL_FROM: Verified sender email address (e.g. "CareCircle <care@yourdomain.com>").
# Also honors RESEND_FROM_EMAIL for backwards compatibility.
EMAIL_FROM="CareCircle <onboarding@resend.dev>"

# RESEND_API_KEY: Optional API key for sending email reminders via Resend (https://api.resend.com/emails).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CareCircle <onboarding@resend.dev>"

# SENDGRID_API_KEY: Optional API key for sending email reminders via SendGrid (https://api.sendgrid.com/v3/mail/send).
SENDGRID_API_KEY=""

# EMAIL_WEBHOOK_URL: Optional HTTPS webhook endpoint for custom SMTP-relay or notification microservice delivery.
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_AUTH_HEADER=""

# CRON_SECRET: Optional secret header (x-cron-secret or Authorization: Bearer) for authenticating scheduled calls to POST /api/reminders/process.
CRON_SECRET=""
